{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UE Dev Hub",
  "version": "0.1.0",
  "identifier": "com.chillpert.uedevhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "UE Dev Hub",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' addon: http://addon.localhost; style-src 'self' 'unsafe-inline' addon: http://addon.localhost; img-src 'self' data: addon: http://addon.localhost; font-src 'self' addon: http://addon.localhost; connect-src ipc: http://ipc.localhost addon: http://addon.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "chillpert",
    "copyright": "Copyright (c) 2026 chillpert",
    "license": "MIT",
    "homepage": "https://github.com/chillpert/ue-dev-hub",
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  },
  "mainBinaryName": "ue-dev-hub",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OENBMzE5QjJBN0Y3MUYKUldRZjk2ZXlHYU9NZHJ1QXNqc3NTQkRGOFRXRldoQjRzNXVmcEZ5b05HVnRtRk9kcW5vQVdUVjQK",
      "endpoints": [
        "https://github.com/chillpert/ue-dev-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}